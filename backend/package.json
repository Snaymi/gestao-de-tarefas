{
  "name": "tasks-api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/src/main.js",
    "start:production": "npm run db:migrate && npm run start",
    "admin:create": "tsx prisma/create-admin.ts",
    "test": "jest --runInBand",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:generate": "prisma generate"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0", "@nestjs/core": "^11.0.0", "@nestjs/jwt": "^11.0.0", "@nestjs/platform-express": "^11.0.0", "@prisma/client": "6.19.3", "bcryptjs": "^3.0.0", "class-transformer": "^0.5.1", "class-validator": "^0.14.2", "cookie-parser": "^1.4.7", "dotenv": "^17.0.0", "reflect-metadata": "^0.2.2", "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0", "@nestjs/testing": "^11.0.0", "@types/cookie-parser": "^1.4.8", "@types/express": "^5.0.0", "@types/jest": "^30.0.0", "@types/node": "^24.0.0", "jest": "^30.0.0", "prisma": "6.19.3", "ts-jest": "^29.4.0", "tsx": "^4.20.0", "typescript": "^5.9.0"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "@prisma/config": { "effect": "3.22.1" }
  },
  "jest": {"preset":"ts-jest","testEnvironment":"node","rootDir":"src","testRegex":".*\\.spec\\.ts$"}
}
